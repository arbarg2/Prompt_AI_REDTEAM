# Copy to .env and replace BOTH keys. Never commit .env.
# Generate keys with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TARGET_API_KEY=
ADMIN_API_KEY=

# Optional tuning (defaults shown)
DEFAULT_PROFILE=support
RECORD_COUNT=1000
# Leave empty for a random seed at startup; set an integer to reproduce a dataset
DEMO_SEED=
# Requests per minute allowed on /chat (0 disables). Raise or disable during scans.
RATE_LIMIT_PER_MINUTE=600
SESSION_TTL_SECONDS=900
MAX_PROMPT_CHARS=8000
MAX_OUTPUT_CHARS=16000
LOG_LEVEL=INFO
